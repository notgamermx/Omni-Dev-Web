---
// Download page
import Layout from '@components/Layout.astro';
import { getReleases, getSiteContent } from '../lib/content';
import { formatDate, formatFileSize, escapeHtml } from '../lib/utils';

const releases = await getReleases();
const latestRelease = releases.find(r => r.is_latest) || releases[0] || null;
const siteContent = await getSiteContent();

const platformDef = {
  windows: { title: 'Windows (x64)', icon: '🪟', ext: '.exe / .msi', cmd: 'winget install OmniDev  •  or run the installer from GitHub Releases' },
  linux: { title: 'Linux (x64)', icon: '🐧', ext: '.AppImage / .deb', cmd: 'chmod +x OmniDev_*.AppImage && ./OmniDev_*.AppImage' },
  macos: { title: 'macOS (Universal)', icon: '🍎', ext: '.dmg', cmd: 'Open OmniDev.dmg → drag to Applications' },
  source: { title: 'Build from Source / CLI', icon: '🔧', ext: 'Git + Node + Python + Rust', cmd: `git clone https://github.com/notgamermx/omnidev.git && cd omnidev\npip install -r requirements.txt\nnpm install && npm run dev` }
};
---

<Layout title="Download OmniDev" description="Download OmniDev for Windows, Linux, macOS, or build from source. Synced with GitHub Releases.">
  <div class="space-y-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-border pb-6">
      <div>
        <div class="text-xs font-mono text-accent/70 uppercase tracking-widest mb-1">Distribution</div>
        <h1 class="text-2xl font-bold text-textMain">Download OmniDev</h1>
        <p class="text-sm text-textMuted mt-1">Synced with <a href="https://github.com/notgamermx/omnidev/releases" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline font-mono">github.com/notgamermx/omnidev/releases</a></p>
      </div>
      <button id="refresh-releases-btn" type="button" class="self-start px-4 py-2 rounded-lg bg-surface border border-borderStrong hover:border-accent/50 text-xs font-semibold text-textSub transition-all flex items-center gap-2">
        ↻ Refresh from GitHub
      </button>
    </div>

    <!-- Release info card -->
    <div class="p-5 rounded-xl bg-surface border border-border flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-accentSoft border border-borderGlow flex items-center justify-center text-xl">🚀</div>
        <div>
          <div class="text-xs text-textMuted mb-0.5">Latest Stable Release</div>
          <div class="font-mono text-sm font-bold text-accent">
            {latestRelease ? escapeHtml(latestRelease.version) : 'No published release yet'}
          </div>
        </div>
      </div>
      {latestRelease && <div class="text-xs text-textMuted">Published {formatDate(latestRelease.published_at)}</div>}
    </div>

    <!-- Platform tabs -->
    <div class="flex flex-wrap gap-2" id="platform-tabs">
      {Object.entries(platformDef).map(([p, def]) => (
        <button type="button" data-dl-platform={p} class={`flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-semibold border transition-all ${p === 'windows' ? 'tab-active' : 'bg-surface border-border text-textMuted hover:text-textMain hover:border-borderStrong'}`}>
          <span>{def.icon}</span> {def.title}
        </button>
      ))}
    </div>

    <!-- Asset list / source -->
    <div class="p-6 rounded-xl bg-surface border border-border space-y-5" id="platform-content">
      {(() => {
        const platform = 'windows';
        const platDef = platformDef[platform];
        const assets = latestRelease?.assets || [];
        const matchingAssets = assets.filter(a => {
          const n = a.name.toLowerCase();
          if (platform === 'windows') return n.endsWith('.exe') || n.endsWith('.msi') || n.includes('win');
          if (platform === 'linux') return n.endsWith('.appimage') || n.endsWith('.deb') || n.includes('linux');
          if (platform === 'macos') return n.endsWith('.dmg') || n.includes('mac') || n.includes('darwin');
          return false;
        });

        return (
          <>
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h2 class="text-base font-bold text-textMain flex items-center gap-2">
                <span>{platDef.icon}</span> {platDef.title}
              </h2>
              <span class="font-mono text-xs text-textDim px-2 py-0.5 rounded bg-elevated border border-border">{platDef.ext}</span>
            </div>

            {platform !== 'source' ? (
              matchingAssets.length > 0 ? (
                <div class="space-y-2">
                  {matchingAssets.map(a => (
                    <div class="flex flex-wrap items-center justify-between gap-3 p-4 rounded-lg bg-bg border border-border hover:border-borderStrong transition-all">
                      <div>
                        <div class="font-mono text-sm text-textMain">{escapeHtml(a.name)}</div>
                        <div class="text-[11px] text-textDim mt-0.5">{formatFileSize(a.size)} · Downloads: {a.download_count.toLocaleString()}</div>
                      </div>
                      <a href={a.browser_download_url} target="_blank" rel="noopener noreferrer" class="px-4 py-2 rounded-lg shimmer-btn text-white text-xs font-semibold shadow-glow-blue">Download</a>
                    </div>
                  ))}
                </div>
              ) : (
                <div class="p-5 rounded-lg bg-bg border border-border text-xs text-textMuted space-y-2">
                  <div class="flex items-center gap-2">
                    <span class="text-amber">⚠</span>
                    <span>No pre-built <span class="font-mono text-textSub">{platDef.ext}</span> assets on the latest release.</span>
                  </div>
                  <a href="https://github.com/notgamermx/omnidev/releases" target="_blank" rel="noopener noreferrer" class="inline-block text-accent hover:underline">View all GitHub Releases →</a>
                </div>
              )
            ) : (
              <div class="space-y-4">
                <p class="text-xs text-textMuted leading-relaxed">Clone the repository and launch both the FastAPI backend and React/Tauri frontend:</p>
                {[
                  'git clone https://github.com/notgamermx/omnidev.git && cd omnidev',
                  'pip install -r requirements.txt',
                  'npm install && npm run dev',
                ].map(cmd => (
                  <div class="code-block p-4 flex items-center justify-between gap-3 group">
                    <code class="text-sm text-green-400 font-mono flex-1 overflow-x-auto">$ {escapeHtml(cmd)}</code>
                    <button type="button" data-copy={escapeHtml(cmd)} class="px-2.5 py-1 rounded bg-elevated border border-border text-[11px] text-textDim hover:text-textMain shrink-0 opacity-0 group-hover:opacity-100 transition-all">Copy</button>
                  </div>
                ))}
              </div>
            )}

            <div class="pt-4 border-t border-border">
              <div class="text-xs font-semibold text-textSub mb-2">📋 Verification & Install Note</div>
              <div class="code-block p-4 text-xs text-textMuted font-mono whitespace-pre-wrap">{escapeHtml(platDef.cmd)}</div>
            </div>
          </>
        );
      })()}
    </div>
  </div>
</Layout>

<script>
  // Platform tab switching
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('[data-dl-platform]');
    const content = document.getElementById('platform-content');
    const platformDef = {
      windows: { title: 'Windows (x64)', icon: '🪟', ext: '.exe / .msi', cmd: 'winget install OmniDev  •  or run the installer from GitHub Releases' },
      linux: { title: 'Linux (x64)', icon: '🐧', ext: '.AppImage / .deb', cmd: 'chmod +x OmniDev_*.AppImage && ./OmniDev_*.AppImage' },
      macos: { title: 'macOS (Universal)', icon: '🍎', ext: '.dmg', cmd: 'Open OmniDev.dmg → drag to Applications' },
      source: { title: 'Build from Source / CLI', icon: '🔧', ext: 'Git + Node + Python + Rust', cmd: `git clone https://github.com/notgamermx/omnidev.git && cd omnidev\npip install -r requirements.txt\nnpm install && npm run dev` }
    };

    // We need the releases data - for now we'll use the latest from the page
    // In a real implementation, this would fetch from an API
    const releaseAssets = []; // Would be populated from server data

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        // Update active tab
        tabs.forEach(t => t.classList.remove('tab-active'));
        tabs.forEach(t => t.classList.add('bg-surface', 'border-border', 'text-textMuted'));
        tab.classList.add('tab-active');
        tab.classList.remove('bg-surface', 'border-border', 'text-textMuted');

        const platform = tab.getAttribute('data-dl-platform');
        const platDef = platformDef[platform];

        // Update content - simplified version
        // In production, this would re-render with the correct assets
        content.innerHTML = `
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h2 class="text-base font-bold text-textMain flex items-center gap-2">
              <span>${platDef.icon}</span> ${platDef.title}
            </h2>
            <span class="font-mono text-xs text-textDim px-2 py-0.5 rounded bg-elevated border border-border">${platDef.ext}</span>
          </div>
          ${platform !== 'source' ? `
            <div class="p-5 rounded-lg bg-bg border border-border text-xs text-textMuted space-y-2">
              <div class="flex items-center gap-2">
                <span class="text-amber">⚠</span>
                <span>No pre-built <span class="font-mono text-textSub">${platDef.ext}</span> assets on the latest release.</span>
              </div>
              <a href="https://github.com/notgamermx/omnidev/releases" target="_blank" rel="noopener noreferrer" class="inline-block text-accent hover:underline">View all GitHub Releases →</a>
            </div>
          ` : `
            <div class="space-y-4">
              <p class="text-xs text-textMuted leading-relaxed">Clone the repository and launch both the FastAPI backend and React/Tauri frontend:</p>
              ${[
                'git clone https://github.com/notgamermx/omnidev.git && cd omnidev',
                'pip install -r requirements.txt',
                'npm install && npm run dev',
              ].map(cmd => `
                <div class="code-block p-4 flex items-center justify-between gap-3 group">
                  <code class="text-sm text-green-400 font-mono flex-1 overflow-x-auto">$ ${cmd}</code>
                  <button type="button" data-copy="${cmd}" class="px-2.5 py-1 rounded bg-elevated border border-border text-[11px] text-textDim hover:text-textMain shrink-0 opacity-0 group-hover:opacity-100 transition-all">Copy</button>
                </div>
              `).join('')}
            </div>
          `}
          <div class="pt-4 border-t border-border">
            <div class="text-xs font-semibold text-textSub mb-2">📋 Verification & Install Note</div>
            <div class="code-block p-4 text-xs text-textMuted font-mono whitespace-pre-wrap">${platDef.cmd}</div>
          </div>
        `;
      });
    });

    // Copy buttons
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-copy]');
      if (btn) {
        navigator.clipboard.writeText(btn.getAttribute('data-copy')).then(() => {
          btn.textContent = 'Copied!';
          setTimeout(() => btn.textContent = 'Copy', 1500);
        });
      }
    });
  });
</script>