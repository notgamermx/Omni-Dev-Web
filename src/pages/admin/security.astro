---
// Admin security reports viewer
import Layout from '@components/Layout.astro';
---

<Layout title="Admin: Security Reports" description="View security vulnerability reports (admin only).">
  <div class="max-w-4xl mx-auto space-y-8">
    <div class="flex items-center justify-between gap-4 border-b border-border pb-4">
      <div>
        <a href="/admin" class="text-xs text-textMuted hover:text-textMain mb-2 inline-block">← Back to Dashboard</a>
        <h1 class="text-2xl font-bold text-textMain">Security Reports</h1>
        <p class="text-xs text-textMuted mt-1">Only visible to admin users. Handle with care.</p>
      </div>
    </div>

    <div class="p-6 rounded-xl bg-surface border border-border space-y-4">
      <div id="security-list" class="space-y-3">
        <div class="text-center text-textMuted py-8">Loading...</div>
      </div>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    const listEl = document.getElementById('security-list');

    async function loadReports() {
      try {
        const token = localStorage.getItem('sb-access-token');
        const res = await fetch('/api/cms', {
          headers: { 'Authorization': `Bearer ${token || ''}` }
        });
        if (res.ok) {
          const data = await res.json();
          renderReports(data.security || []);
        } else if (res.status === 403) {
          listEl.innerHTML = '<div class="text-center text-textMuted py-8">Admin access required</div>';
        } else {
          listEl.innerHTML = '<div class="text-center text-textMuted py-8">Failed to load reports</div>';
        }
      } catch (e) {
        console.error('Failed to load security reports:', e);
        listEl.innerHTML = '<div class="text-center text-textMuted py-8">Error loading reports</div>';
      }
    }

    function getStatusStyle(status) {
      const styles = {
        open: { badge: 'text-danger border-danger/30 bg-dangerSoft', label: 'Open' },
        investigating: { badge: 'text-amber border-amber/30 bg-amberSoft', label: 'Investigating' },
        resolved: { badge: 'text-success border-success/30 bg-successSoft', label: 'Resolved' },
        rejected: { badge: 'text-textDim border-border bg-elevated', label: 'Rejected' },
      };
      return styles[status] || styles.open;
    }

    function getSeverityStyle(severity) {
      const styles = {
        Critical: { color: 'text-danger', bg: 'bg-dangerSoft', border: 'border-danger/30' },
        High: { color: 'text-red-400', bg: 'bg-red-400/10', border: 'border-red-400/30' },
        Medium: { color: 'text-amber', bg: 'bg-amberSoft', border: 'border-amber/30' },
        Low: { color: 'text-green-400', bg: 'bg-green-400/10', border: 'border-green-400/30' },
      };
      return styles[severity] || styles.Medium;
    }

    function renderReports(items) {
      if (items.length === 0) {
        listEl.innerHTML = '<div class="text-center text-textMuted py-8">No security reports</div>';
        return;
      }

      listEl.innerHTML = items.map(r => {
        const st = getStatusStyle(r.status);
        const sev = getSeverityStyle(r.severity);
        return `
          <div class="p-4 rounded-lg bg-bg border border-border space-y-3">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div class="flex items-center gap-2">
                <span class="font-mono text-sm text-textMain">${r.component}</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded-full ${sev.border} ${sev.color} ${sev.bg}">${r.severity}</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded-full border ${st.badge}">${st.label}</span>
              </div>
              <div class="text-xs text-textDim">${new Date(r.created_at).toLocaleDateString()}</div>
            </div>
            <div class="text-xs text-textMuted leading-relaxed">${r.details}</div>
            ${r.reporter_email ? `<div class="text-xs text-textDim">Reporter: ${r.reporter_email}</div>` : ''}
          </div>
        `;
      }).join('');
    }

    await loadReports();
  });
</script>