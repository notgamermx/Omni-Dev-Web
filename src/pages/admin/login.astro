---
// Admin login page
import Layout from '@components/Layout.astro';
---

<Layout title="Admin Login" description="Sign in to access the OmniDev Admin CMS.">
  <div class="max-w-md mx-auto mt-20">
    <div class="text-center mb-8">
      <div class="w-16 h-16 rounded-xl bg-gradient-to-br from-accent to-purple flex items-center justify-center font-bold text-white text-2xl mx-auto mb-4">OD</div>
      <h1 class="text-2xl font-bold text-textMain">Admin Sign In</h1>
      <p class="text-sm text-textMuted mt-2">Sign in with your admin account to access the CMS</p>
    </div>

    <div class="p-6 rounded-xl bg-surface border border-border space-y-4" id="login-form">
      <div id="auth-message" class="hidden p-3 rounded-lg text-xs"></div>

      <div>
        <label class="block text-xs text-textMuted mb-1.5 font-medium" for="email">Email</label>
        <input id="email" type="email" autocomplete="email" placeholder="admin@omnidev.dev" class="w-full px-3 py-2.5 rounded-lg bg-bg border border-border text-textMain text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accentGlow transition-colors" />
      </div>

      <div>
        <label class="block text-xs text-textMuted mb-1.5 font-medium" for="password">Password</label>
        <input id="password" type="password" autocomplete="current-password" placeholder="••••••••" class="w-full px-3 py-2.5 rounded-lg bg-bg border border-border text-textMain text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accentGlow transition-colors" />
      </div>

      <button id="signin-btn" type="button" class="w-full py-2.5 rounded-lg bg-accent hover:bg-accentHover text-white text-sm font-semibold transition-colors shadow-glow-blue">
        Sign In
      </button>

      <p class="text-xs text-textMuted text-center">Using Supabase Auth — magic link or email/password</p>
    </div>

    <div class="text-center mt-6">
      <a href="/" class="text-xs text-textMuted hover:text-textMain">← Back to site</a>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('login-form');
    const emailInput = document.getElementById('email');
    const passwordInput = document.getElementById('password');
    const signinBtn = document.getElementById('signin-btn');
    const messageEl = document.getElementById('auth-message');

    // Check if already logged in
    const token = localStorage.getItem('sb-access-token');
    if (token) {
      window.location.href = '/admin';
      return;
    }

    function showMessage(msg, type) {
      messageEl.textContent = msg;
      messageEl.className = `p-3 rounded-lg text-xs ${type === 'success' ? 'bg-successSoft border-success/30 text-success' : 'bg-dangerSoft border-danger/30 text-danger'}`;
      messageEl.classList.remove('hidden');
    }

    signinBtn?.addEventListener('click', async () => {
      const email = emailInput.value.trim();
      const password = passwordInput.value;

      if (!email || !password) {
        showMessage('Please enter email and password', 'error');
        return;
      }

      signinBtn.textContent = 'Signing in...';
      signinBtn.disabled = true;

      try {
        // Use Supabase auth
        const res = await fetch(`${import.meta.env.SUPABASE_URL}/auth/v1/token?grant_type=password`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'apikey': import.meta.env.SUPABASE_ANON_KEY,
          },
          body: JSON.stringify({ email, password }),
        });

        const data = await res.json();

        if (res.ok && data.access_token) {
          localStorage.setItem('sb-access-token', data.access_token);
          localStorage.setItem('sb-refresh-token', data.refresh_token);
          showMessage('✓ Signed in successfully!', 'success');
          setTimeout(() => window.location.href = '/admin', 1000);
        } else {
          showMessage(data.msg || data.error_description || 'Sign in failed', 'error');
        }
      } catch (e) {
        showMessage('Network error. Please try again.', 'error');
      } finally {
        signinBtn.textContent = 'Sign In';
        signinBtn.disabled = false;
      }
    });

    // Enter key support
    [emailInput, passwordInput].forEach(input => {
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') signinBtn?.click();
      });
    });
  });
</script>