---
// License page
import Layout from '@components/Layout.astro';
import { escapeHtml } from '../lib/utils';

const REPO_OWNER = 'notgamermx';
const REPO_NAME = 'omnidev';
const REPO_URL = `https://github.com/${REPO_OWNER}/${REPO_NAME}`;
---

<Layout title="Copyright & License" description="Project ownership, software licensing, third-party notices, and trademark policy.">
  <div class="space-y-8 max-w-4xl">
    <div class="border-b border-border pb-6">
      <div class="text-xs font-mono text-accent/70 uppercase tracking-widest mb-1">Legal</div>
      <h1 class="text-2xl font-bold text-textMain">Copyright & License</h1>
      <p class="text-sm text-textMuted mt-1">Project ownership, software licensing, third-party notices, and trademark policy.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <div class="p-6 rounded-xl bg-surface border border-border space-y-3">
        <div class="text-2xl">⚖️</div>
        <h2 class="text-sm font-bold text-textMain">Project Ownership & License</h2>
        <p class="text-xs text-textMuted leading-relaxed">OmniDev is maintained by <code class="font-mono text-textSub">{REPO_OWNER}</code>.</p>
        <div class="font-mono text-sm font-bold text-accent">MIT License</div>
        <a href={`${REPO_URL}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-xs text-accent hover:underline">View LICENSE on GitHub →</a>
      </div>
      <div class="p-6 rounded-xl bg-surface border border-border space-y-3">
        <div class="text-2xl">™</div>
        <h2 class="text-sm font-bold text-textMain">Trademark & Attribution</h2>
        <p class="text-xs text-textMuted leading-relaxed">The OmniDev name and wordmark identify the official releases from <code class="font-mono text-xs">github.com/notgamermx/omnidev</code>. Forks must clearly state modifications and attribute upstream authors.</p>
      </div>
    </div>
    <div class="p-6 rounded-xl bg-surface border border-border space-y-4">
      <h2 class="text-sm font-bold text-textMain">Third-Party Open-Source Notices</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
        {[
          { name: 'Tauri 2', desc: 'Desktop application framework', lic: 'MIT / Apache 2.0' },
          { name: 'React & TypeScript', desc: 'Workbench UI layer', lic: 'MIT' },
          { name: 'FastAPI', desc: 'Local Python API backend', lic: 'MIT' },
          { name: 'SQLite', desc: 'Persistent local storage', lic: 'Public Domain' },
          { name: 'GSAP', desc: 'Animation library (Free tier)', lic: 'Standard' },
          { name: 'Tailwind CSS', desc: 'Utility CSS framework', lic: 'MIT' },
        ].map(t => (
          <div class="p-3.5 rounded-lg bg-bg border border-border flex items-start justify-between gap-2">
            <div>
              <div class="font-semibold text-textSub">{t.name}</div>
              <div class="text-textDim mt-0.5">{t.desc}</div>
            </div>
            <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-elevated border border-border text-textDim shrink-0">{t.lic}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>