---
// Footer component
---

<footer class="relative z-10 border-t border-border bg-surface/60 backdrop-blur-sm mt-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 text-sm">
    <div>
      <div class="flex items-center gap-2.5 mb-3">
        <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-accent to-blue-700 flex items-center justify-center font-mono text-[11px] font-bold text-white">OD</div>
        <span class="font-bold text-textMain">OmniDev</span>
      </div>
      <p class="text-xs text-textMuted leading-relaxed mb-4">
        AI-powered desktop development environment with autonomous coding agents, multi-provider LLM orchestration, and explicit execution controls.
      </p>
      <div class="flex items-center gap-2">
        <a href="https://github.com/notgamermx/omnidev" target="_blank" rel="noopener noreferrer" aria-label="GitHub"
          class="w-7 h-7 rounded-md bg-elevated border border-border flex items-center justify-center hover:border-borderStrong transition-colors text-textMuted hover:text-textMain">
          <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        </a>
      </div>
    </div>
    <div>
      <div class="font-semibold text-textSub mb-3 text-xs uppercase tracking-widest">Product</div>
      <ul class="space-y-2 text-xs text-textMuted">
        <li><a href="/" class="hover:text-textMain transition-colors">Overview</a></li>
        <li><a href="/download" class="hover:text-textMain transition-colors">Download</a></li>
        <li><a href="/updates" class="hover:text-textMain transition-colors">Updates & Roadmap</a></li>
        <li><a href="/docs" class="hover:text-textMain transition-colors">Documentation</a></li>
      </ul>
    </div>
    <div>
      <div class="font-semibold text-textSub mb-3 text-xs uppercase tracking-widest">Governance</div>
      <ul class="space-y-2 text-xs text-textMuted">
        <li><a href="/license" class="hover:text-textMain transition-colors">Copyright & License</a></li>
        <li><a href="/security" class="hover:text-textMain transition-colors">Security Policy</a></li>
        <li><a href="/about" class="hover:text-textMain transition-colors">About & Contributors</a></li>
      </ul>
    </div>
    <div>
      <div class="font-semibold text-textSub mb-3 text-xs uppercase tracking-widest">Community</div>
      <ul class="space-y-2 text-xs text-textMuted">
        <li><a href="https://github.com/notgamermx/omnidev" target="_blank" rel="noopener noreferrer" class="hover:text-textMain transition-colors">GitHub Repository</a></li>
        <li><a href="/community" class="hover:text-textMain transition-colors">Feedback & Issues</a></li>
        <li><a href="/admin" class="text-accent hover:text-blue-400 transition-colors">Admin CMS ↗</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-border/50 py-5 px-4 sm:px-6 max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-textDim">
    <span>&copy; 2026 OmniDev Project — <a href="https://github.com/notgamermx/omnidev" target="_blank" rel="noopener noreferrer" class="text-textMuted hover:text-textSub underline underline-offset-2 transition-colors">notgamermx/omnidev</a></span>
    <div class="flex items-center gap-3">
      <span id="footer-repo-stats" class="font-mono text-[11px] flex items-center gap-2">
        <span id="footer-stars" class="hidden items-center gap-1">
          <svg class="w-3.5 h-3.5 text-amber" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <span id="footer-stars-count">0</span>
        </span>
        <span class="text-textDim">github.com/notgamermx/omnidev</span>
      </span>
    </div>
  </div>
</footer>

<script>
  // Fetch GitHub stars for footer
  async function fetchFooterStats() {
    try {
      const res = await fetch('https://api.github.com/repos/notgamermx/omnidev');
      if (res.ok) {
        const data = await res.json();
        const starsEl = document.getElementById('footer-stars');
        const starsCount = document.getElementById('footer-stars-count');
        if (starsEl && starsCount) {
          starsCount.textContent = (data.stargazers_count ?? 0).toLocaleString();
          starsEl.classList.remove('hidden');
          starsEl.classList.add('flex');
        }
      }
    } catch (e) {
      console.debug('Footer stats fetch failed:', e);
    }
  }

  document.addEventListener('DOMContentLoaded', fetchFooterStats);
</script>