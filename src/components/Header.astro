---
// Header component with navigation
---

<header id="main-header" class="sticky top-0 z-30 transition-all duration-200">
  <div class="bg-bg/90 backdrop-blur-md border-b border-border/70">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-4">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 group" data-tooltip="Home">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-accent to-blue-700 flex items-center justify-center font-mono text-xs font-bold text-white shadow-glow-blue group-hover:shadow-glow-blue-lg transition-shadow">
          OD
        </div>
        <div class="flex flex-col leading-none">
          <span class="font-bold tracking-tight text-textMain text-[15px]">OmniDev</span>
          <span class="text-[10px] text-textDim font-mono leading-none">AI Dev Env</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav id="desktop-nav" class="hidden lg:flex items-center gap-0.5" aria-label="Primary">
        <a href="/" class="nav-link px-3 py-1.5 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-surface">Home</a>
        <a href="/download" class="nav-link px-3 py-1.5 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-surface">Download</a>
        <a href="/updates" class="nav-link px-3 py-1.5 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-surface">Updates</a>
        <a href="/docs" class="nav-link px-3 py-1.5 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-surface">Docs</a>
        <a href="/license" class="nav-link px-3 py-1.5 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-surface">License</a>
        <a href="/security" class="nav-link px-3 py-1.5 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-surface">Security</a>
        <a href="/community" class="nav-link px-3 py-1.5 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-surface">Community</a>
        <a href="/about" class="nav-link px-3 py-1.5 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-surface">About</a>
      </nav>

      <!-- Right actions -->
      <div class="flex items-center gap-2">
        <!-- Command palette trigger -->
        <button id="cmd-palette-btn" type="button" data-tooltip="Quick search (⌘K)"
          class="hidden sm:flex items-center gap-2 px-2.5 py-1.5 rounded-md bg-surface border border-border hover:border-borderStrong text-xs text-textDim transition-all group">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 19A8 8 0 103 11a8 8 0 008 8z"/>
          </svg>
          <span class="font-mono text-[10px] text-textDim px-1 py-0.5 rounded bg-elevated border border-border">⌘K</span>
        </button>

        <a href="https://github.com/notgamermx/omnidev" target="_blank" rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-medium bg-surface border border-border hover:border-borderStrong text-textSub transition-all">
          <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
          </svg>
          GitHub
        </a>

        <a href="/download" class="shimmer-btn px-3.5 py-1.5 rounded-md text-xs font-semibold text-white transition-all shadow-glow-blue hover:shadow-glow-blue-lg">
          Download
        </a>

        <button id="mobile-menu-btn" type="button"
          class="lg:hidden p-1.5 rounded-md border border-border bg-surface text-textSub hover:border-borderStrong transition-all" aria-label="Toggle menu" aria-expanded="false">
          <svg id="mobile-menu-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="mobile-menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Nav Drawer -->
    <div id="mobile-nav" class="lg:hidden border-t border-border/50 bg-surface/95 px-4 pb-4 pt-3">
      <div class="grid grid-cols-2 gap-1">
        <a href="/" class="nav-link text-left px-3 py-2.5 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-elevated">🏠 Home</a>
        <a href="/download" class="nav-link text-left px-3 py-2.5 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-elevated">⬇️ Download</a>
        <a href="/updates" class="nav-link text-left px-3 py-2.5 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-elevated">🔄 Updates</a>
        <a href="/docs" class="nav-link text-left px-3 py-2.5 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-elevated">📖 Docs</a>
        <a href="/license" class="nav-link text-left px-3 py-2.5 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-elevated">⚖️ License</a>
        <a href="/security" class="nav-link text-left px-3 py-2.5 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-elevated">🔒 Security</a>
        <a href="/community" class="nav-link text-left px-3 py-2.5 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-elevated">💬 Community</a>
        <a href="/about" class="nav-link text-left px-3 py-2.5 rounded-md text-sm font-medium text-textMuted hover:text-textMain hover:bg-elevated">ℹ️ About</a>
      </div>
      <div class="mt-3 pt-3 border-t border-border flex gap-2">
        <a href="https://github.com/notgamermx/omnidev" target="_blank" rel="noopener noreferrer"
          class="flex-1 text-center py-2 rounded-md bg-elevated border border-border text-xs font-medium text-textSub">View on GitHub</a>
        <a href="/download" class="flex-1 py-2 rounded-md bg-accent text-white text-xs font-semibold">Download</a>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile nav toggle
  document.addEventListener('DOMContentLoaded', () => {
    let mobileOpen = false;
    const nav = document.getElementById('mobile-nav');
    const btn = document.getElementById('mobile-menu-btn');
    const openIcon = document.getElementById('mobile-menu-icon-open');
    const closeIcon = document.getElementById('mobile-menu-icon-close');

    function closeMobileNav() {
      mobileOpen = false;
      nav?.classList.remove('open');
      btn?.setAttribute('aria-expanded', 'false');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }

    btn?.addEventListener('click', () => {
      mobileOpen = !mobileOpen;
      nav?.classList.toggle('open', mobileOpen);
      btn?.setAttribute('aria-expanded', String(mobileOpen));
      openIcon?.classList.toggle('hidden', mobileOpen);
      closeIcon?.classList.toggle('hidden', !mobileOpen);
    });

    // Close on link click
    nav?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', closeMobileNav);
    });

    // Close on escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMobileNav();
    });
  });
</script>